      "title": "Description",
      "type": "string"
    },
    "domain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain"
    },
    "version": {
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "protocol_versions": {
      "items": {
        "type": "string"
