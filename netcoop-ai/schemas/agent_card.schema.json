    "accepts": {
      "items": {
        "type": "string"
      },
      "title": "Accepts",
      "type": "array"
    },
    "produces": {
      "items": {
        "type": "string"
      },
      "title": "Produces",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "type": "string"
      },
      "title": "Hypotheses",
      "type": "array"
    },
